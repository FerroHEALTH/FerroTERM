# Normalize line endings: Git stores text with LF and checks it out with LF on
# every platform.
* text=auto eol=lf

# Vendored trees (test corpora, machine-readable grammars) are exempt from
# GitHub language stats and collapse in diffs. Extend the list when a new
# vendored tree lands (see .claude/rules/vendored-inputs.md).
crates/*/vendor/** linguist-vendored
addons/*/vendor/** linguist-vendored

# A vendored listing is stored byte-for-byte as its publisher serves it, so the
# line-ending normalization above must not touch it: one service serves CRLF,
# and rewriting it would change the bytes the provenance stamp records.
crates/terminology-syndication/vendor/feeds/*.xml -text -diff

# Generated by scripts/security/vex-generate.sh; never edited by hand.
security/vex/rust-advisories.openvex.json linguist-generated
